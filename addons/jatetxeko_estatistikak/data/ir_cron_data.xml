<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sinkronizazio osorako ekintza programatua -->
        <record id="ir_cron_sync_all" model="ir.cron">
            <field name="name">Jatetxea: API Sinkronizazio Osoa</field>
            <field name="model_id" ref="model_jatetxeko_api_sync"/>
            <field name="state">code</field>
            <field name="code">model.sync_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Eskaerak bakarrik sinkronizatzeko ekintza programatua (maizago) -->
        <record id="ir_cron_sync_orders" model="ir.cron">
            <field name="name">Jatetxea: Eskaeren Sinkronizazioa</field>
            <field name="model_id" ref="model_jatetxeko_api_sync"/>
            <field name="state">code</field>
            <field name="code">model.sync_orders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
