<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_eskaera_tree" model="ir.ui.view">
            <field name="name">jatetxeko.eskaera.tree</field>
            <field name="model">jatetxeko.eskaera</field>
            <field name="arch" type="xml">
                <tree decoration-muted="state == 'draft'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="zerbitzaria_id"/>
                    <field name="mahia_id"/>
                    <field name="subtotal"/>
                    <field name="discount_id"/>
                    <field name="discount_amount"/>
                    <field name="total_amount" sum="total"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_eskaera_form" model="ir.ui.view">
            <field name="name">jatetxeko.eskaera.form</field>
            <field name="model">jatetxeko.eskaera</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" string="Berretsi" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_pay" string="Ordaindu" type="object" class="btn-success" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="date"/>
                                <field name="external_id"/>
                            </group>
                            <group>
                                <field name="zerbitzaria_id"/>
                                <field name="mahia_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lerroak">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="platera_id"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal" sum="subtotal"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Deskuntua">
                                <group>
                                    <field name="discount_id"/>
                                    <field name="discount_percent"/>
                                </group>
                            </page>
                        </notebook>
                        <group class="oe_subtotal_footer oe_right">
                            <field name="subtotal" widget="monetary"/>
                            <field name="discount_amount" widget="monetary" attrs="{'invisible': [('discount_id', '=', False)]}"/>
                            <field name="total_amount" widget="monetary" class="oe_subtotal_total_separator"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_eskaera_search" model="ir.ui.view">
            <field name="name">jatetxeko.eskaera.search</field>
            <field name="model">jatetxeko.eskaera</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="zerbitzaria_id"/>
                    <field name="mahia_id"/>
                    <filter string="Gaur" name="today" domain="[('date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')), ('date', '&lt;=', datetime.datetime.now().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="Ordainduta" name="paid" domain="[('state', '=', 'paid')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Zerbitzaria" name="group_by_server" context="{'group_by': 'zerbitzaria_id'}"/>
                        <filter string="Mahaia" name="group_by_table" context="{'group_by': 'mahia_id'}"/>
                        <filter string="Data" name="group_by_date" context="{'group_by': 'date:day'}"/>
                        <filter string="Egoera" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_eskaera" model="ir.actions.act_window">
            <field name="name">Eskaerak</field>
            <field name="res_model">jatetxeko.eskaera</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_eskaera_search"/>
        </record>
    </data>
</odoo>