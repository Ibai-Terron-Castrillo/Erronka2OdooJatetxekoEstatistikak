<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_deskontuak_tree" model="ir.ui.view">
            <field name="name">jatetxeko.deskontuak.tree</field>
            <field name="model">jatetxeko.deskontuak</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="percentage"/>
                    <field name="usage_count"/>
                    <field name="usage_limit"/>
                    <field name="valid_from"/>
                    <field name="valid_until"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_deskontuak_form" model="ir.ui.view">
            <field name="name">jatetxeko.deskontuak.form</field>
            <field name="model">jatetxeko.deskontuak</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="percentage"/>
                            </group>
                            <group>
                                <field name="usage_limit"/>
                                <field name="usage_count" readonly="1"/>
                            </group>
                        </group>
                        <group string="Balio-epea">
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                        <group string="Deskribapena">
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_deskontuak" model="ir.actions.act_window">
            <field name="name">Deskontuak</field>
            <field name="res_model">jatetxeko.deskontuak</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>