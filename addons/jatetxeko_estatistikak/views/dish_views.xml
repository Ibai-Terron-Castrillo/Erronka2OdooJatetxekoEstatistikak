<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_platera_tree" model="ir.ui.view">
            <field name="name">jatetxeko.platera.tree</field>
            <field name="model">jatetxeko.platera</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="price"/>
                    <field name="total_ordered"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_platera_form" model="ir.ui.view">
            <field name="name">jatetxeko.platera.form</field>
            <field name="model">jatetxeko.platera</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="category"/>
                                <field name="external_id"/>
                            </group>
                            <group>
                                <field name="price"/>
                                <field name="total_ordered"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_platera" model="ir.actions.act_window">
            <field name="name">Platerak</field>
            <field name="res_model">jatetxeko.platera</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>