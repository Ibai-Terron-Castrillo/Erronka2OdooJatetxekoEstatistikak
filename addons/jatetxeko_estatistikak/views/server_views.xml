<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Zerrenda-ikuspegia -->
        <record id="view_zerbitzaria_tree" model="ir.ui.view">
            <field name="name">jatetxeko.zerbitzaria.zerrenda</field>
            <field name="model">jatetxeko.zerbitzaria</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="erabiltzailea"/>
                    <field name="external_id"/>
                    <field name="total_orders"/>
                    <field name="total_billing"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Formulario-ikuspegia -->
        <record id="view_zerbitzaria_form" model="ir.ui.view">
            <field name="name">jatetxeko.zerbitzaria.form</field>
            <field name="model">jatetxeko.zerbitzaria</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_push_to_api" type="object" string="APIra Bidali" class="btn-primary" attrs="{'invisible': [('erabiltzailea', '=', False)]}"/>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Oinarrizko Datuak">
                                <field name="name"/>
                                <field name="external_id" readonly="1"/>
                                <field name="active"/>
                            </group>
                            <group string="Saio Hasteko Datuak">
                                <field name="erabiltzailea"/>
                                <field name="pasahitza" password="True"/>
                                <field name="role_id"/>
                                <field name="txat_baimena"/>
                                <field name="erregistro_data"/>
                            </group>
                            <group string="Estatistikak">
                                <field name="total_orders"/>
                                <field name="total_billing"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Eskaerak">
                                <field name="order_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="total_amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Ekintza -->
        <record id="action_zerbitzaria" model="ir.actions.act_window">
            <field name="name">Zerbitzariak</field>
            <field name="res_model">jatetxeko.zerbitzaria</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
