            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="zerbitzaria_eskaera_rule" model="ir.rule">
            <field name="name">Zerbitzaria: Eskaerak irakurtzeko soilik</field>
            <field name="model_id" ref="model_jatetxeko_eskaera"/>
