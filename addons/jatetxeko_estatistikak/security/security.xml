<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Restaurant Category for Groups -->
        <record id="module_category_jatetxeko" model="ir.module.category">
            <field name="name">Jatetxeko Estatistikak</field>
            <field name="description">Manage restaurant statistics access rights</field>
            <field name="sequence">20</field>
        </record>

        <!-- Administrator Group (Full Access) -->
        <record id="group_administratzailea" model="res.groups">
            <field name="name">Administratzailea</field>
            <field name="category_id" ref="module_category_jatetxeko"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Full access: create, read, write, delete</field>
        </record>

        <!-- Server Group (Read-Only Access) -->
        <record id="group_zerbitzaria" model="res.groups">
            <field name="name">Zerbitzaria</field>
            <field name="category_id" ref="module_category_jatetxeko"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read-only access: view data and statistics</field>
        </record>

        <!-- Record Rules for Zerbitzaria (Read-Only) -->
        <record id="zerbitzaria_zerbitzari_rule" model="ir.rule">
            <field name="name">Zerbitzaria: Zerbitzariak irakurtzeko soilik</field>
            <field name="model_id" ref="model_jatetxeko_zerbitzaria"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_zerbitzaria'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="zerbitzaria_platera_rule" model="ir.rule">
            <field name="name">Zerbitzaria: Platerak irakurtzeko soilik</field>
            <field name="model_id" ref="model_jatetxeko_platera"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_zerbitzaria'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

